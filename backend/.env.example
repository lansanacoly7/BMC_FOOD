# Modèle de configuration du backend BMC FOOD.
# Copier ce fichier en `backend/.env` (ignoré par Git) et renseigner les valeurs.
# NE JAMAIS committer de valeurs réelles.

# --- Développement local ---------------------------------------------------
# DJANGO_DEBUG=true

# --- Obligatoires si DJANGO_DEBUG n'est pas "true" (production) -------------
# Clé secrète Django longue et aléatoire (ex. python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
# DJANGO_SECRET_KEY=
# Hôtes autorisés, séparés par des virgules (ex. api.exemple.sn)
# DJANGO_ALLOWED_HOSTS=
# Origines front autorisées par CORS, séparées par des virgules (ex. https://commande.exemple.sn,https://admin.exemple.sn)
# CORS_ALLOWED_ORIGINS=

# --- Optionnelles ----------------------------------------------------------
# Chemin du fichier SQLite (défaut : backend/bmc_orders.sqlite3)
# BMC_DB_PATH=
# Documentation Swagger publique (défaut : true en DEBUG, false sinon : réservée au staff connecté)
# BMC_API_DOCS_PUBLIC=
# Limite de tentatives sur POST /api/auth/token/ (défaut : 10/min)
# BMC_AUTH_THROTTLE_RATE=
# Production derrière HTTPS
# DJANGO_SECURE_SSL_REDIRECT=
# DJANGO_SECURE_HSTS_SECONDS=
