# Modèle de configuration du backend BMC FOOD.
# Copier ce fichier en `backend/.env` (ignoré par Git) et renseigner les valeurs.
# NE JAMAIS committer de valeurs réelles.

# --- Développement local ---------------------------------------------------
# DJANGO_DEBUG=true

# --- Obligatoires si DJANGO_DEBUG n'est pas "true" (production) -------------
# Clé secrète Django longue et aléatoire (ex. python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
# DJANGO_SECRET_KEY=
# Hôtes autorisés, séparés par des virgules (ex. api.exemple.sn)
# DJANGO_ALLOWED_HOSTS=
# Origines front autorisées par CORS, séparées par des virgules (ex. https://commande.exemple.sn,https://admin.exemple.sn)
# CORS_ALLOWED_ORIGINS=

# --- Optionnelles ----------------------------------------------------------
# Base de données PostgreSQL en production (défaut si absent : SQLite local)
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
# DATABASE_URL=postgres://bmc_user:mot_de_passe_factice@127.0.0.1:5432/bmc_food
# Durée de réutilisation des connexions PostgreSQL en secondes (défaut : 60)
# DB_CONN_MAX_AGE=60
# Chemin du fichier SQLite si DATABASE_URL n'est pas défini (défaut : backend/bmc_orders.sqlite3)
# BMC_DB_PATH=
# Cache partagé en production (sinon cache en base PostgreSQL via `python manage.py createcachetable`)
# Si REDIS_URL est renseigné, installer aussi le paquet Python `redis`.
# REDIS_URL=redis://127.0.0.1:6379/1
# Nom de la table de cache en base si REDIS_URL est absent (défaut : bmc_cache)
# BMC_CACHE_TABLE=bmc_cache
# Documentation Swagger publique (défaut : true en DEBUG, false sinon : réservée au staff connecté)
# BMC_API_DOCS_PUBLIC=
# Limite de tentatives sur POST /api/auth/token/ (défaut : 10/min)
# BMC_AUTH_THROTTLE_RATE=
# Production derrière HTTPS
# DJANGO_SECURE_SSL_REDIRECT=
# DJANGO_SECURE_HSTS_SECONDS=
