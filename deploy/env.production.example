# Modèle de variables d'environnement de PRODUCTION — BMC FOOD
# Copier ce fichier sur le VPS vers /etc/bmc/backend.env (chmod 640, chown root:bmc)
# puis remplacer toutes les valeurs factices avant de démarrer bmc-backend.service.
# NE JAMAIS committer de secrets réels dans le dépôt Git.

# --- Mode et secret Django (obligatoires) ------------------------------------
# Doit impérativement rester à 0 en production (active PBKDF2 fort et désactive Debug).
DJANGO_DEBUG=0
# Générer une clé unique : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=REMPLACER-PAR-UNE-CLE-ALEATOIRE-UNIQUE-DE-50-CARACTERES-MIN

# --- Hôtes et origines CORS --------------------------------------------------
# Domaines servis par Caddy (séparés par des virgules).
DJANGO_ALLOWED_HOSTS=bmcfood.sn,www.bmcfood.sn,admin.bmcfood.sn
# Origines navigateur autorisées pour les requêtes cross-origin éventuelles.
CORS_ALLOWED_ORIGINS=https://bmcfood.sn,https://admin.bmcfood.sn

# --- Base de données PostgreSQL & cache partagé ------------------------------
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgres://bmc_user:REMPLACER_PAR_MOT_DE_PASSE_POSTGRES_FORT@127.0.0.1:5432/bmc_food
DB_CONN_MAX_AGE=60
# Table PostgreSQL utilisée par DatabaseCache (créée avec `python manage.py createcachetable`).
BMC_CACHE_TABLE=bmc_cache
# Optionnel : décommenter pour utiliser Redis au lieu de DatabaseCache (nécessite le paquet `redis`).
# REDIS_URL=redis://127.0.0.1:6379/1

# --- HTTPS / Reverse proxy Caddy ---------------------------------------------
# Caddy gère déjà la redirection HTTP -> HTTPS en frontal et Django n'active pas SECURE_PROXY_SSL_HEADER :
# laisser à 0 derrière Caddy pour éviter une boucle de redirection 301 infinie.
DJANGO_SECURE_SSL_REDIRECT=0
# Activer HSTS (31536000 s = 1 an) une fois le certificat HTTPS validé sur le domaine.
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Sécurité API & jetons ---------------------------------------------------
# Désactiver Swagger/Redoc publics en production (accès staff connecté uniquement).
BMC_API_DOCS_PUBLIC=0
# Durée de validité d'un jeton admin en secondes (défaut : 86400 = 24h).
BMC_TOKEN_TTL_SECONDS=86400
